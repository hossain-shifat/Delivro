{
    "expo": {
        "name": "client",
        "slug": "delivro",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "client",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": false,
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.hossainshifatsorganization.delivro",
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false
            }
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "permissions": [
                "android.permission.RECORD_AUDIO"
            ],
            "package": "com.hossainshifatsorganization.delivro"
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png",
            "bundler": "metro"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff",
                    "dark": {
                        "backgroundColor": "#000000"
                    }
                }
            ],
            [
                "expo-image-picker",
                {
                    "photosPermission": "The app accesses your photos to let you share them with your friends.",
                    "colors": {
                        "cropToolbarColor": "#000000"
                    },
                    "dark": {
                        "colors": {
                            "cropToolbarColor": "#000000"
                        }
                    }
                }
            ],
            "expo-secure-store",
            [
                "expo-build-properties",
                {
                    "android": {
                        "newArchEnabled": false
                    },
                    "ios": {
                        "newArchEnabled": false
                    }
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": false
        },
        "extra": {
            "apiUrl": "https://delivro-server-rho.vercel.app/api",
            "router": {},
            "eas": {
                "projectId": "f9da4dac-6f55-429c-8f89-0745b8be26c9"
            }
        },
        "owner": "hossain-shifats-organization"
    }
}
